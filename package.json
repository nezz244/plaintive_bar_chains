{
  "name": "tailadmin-vue-pro-2.0.1",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:all": "npm-run-all --parallel dev server",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:setup": "docker compose up -d mysql && echo 'Waiting for MySQL...' && sleep 12",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "deploy": "npm run build && gh-pages -d dist",
    "build:gh-pages": "NODE_ENV=production npm run build"
  },
