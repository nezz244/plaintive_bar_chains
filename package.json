    "@fullcalendar/vue3": "^6.1.15",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "apexcharts": "^4.4.0",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "dropzone": "^6.0.0-beta.2",
    "express": "^5.2.1",
    "flatpickr": "^4.6.13",
